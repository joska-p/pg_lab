{
    "name": "pg_lab",
    "version": "0.0.0",
    "private": true,
    "workspaces": {
        "packages": [
            "apps/*",
            "packages/*",
            "tools/*"
        ],
        "catalog": {
            "@rolldown/plugin-babel": "^0.2.4",
            "@stylexjs/stylex": "^0.19.0",
            "@types/node": "^26.1.1",
            "@types/react": "^19.3.0",
            "@types/react-dom": "^19.3.0",
            "@vitejs/plugin-react": "^6.1.1",
            "babel-plugin-react-compiler": "^1.0.0",
            "bumpp": "^12.3.0",
            "degit": "^3.10.0",
            "react": "^19.3.0",
            "react-dom": "^19.3.0",
            "typescript": "^7.0.2",
            "unplugin-stylex": "^0.6.3",
            "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
            "vite-plus": "0.3.1",
            "vitest": "4.1.11",
            "zod": "^4.6.5",
            "zustand": "^5.0.15"
        }
    },
    "type": "module",
    "scripts": {
        "ready": "vp check && vp test && vp run -r --concurrency-limit 1 build",
        "dev": "vp -C apps/playground dev --host",
        "dev:brouillon": "vp -C apps/brouillon dev --host",
        "build": "vp run @repo/playground#build",
        "prepare": "vp config",
        "clean": "pnpm clean:cache && pnpm clean:dist && pnpm clean:tsbuildinfo && pnpm clean:modules",
        "clean:cache": "vp cache clean",
        "clean:dist": "find . -name node_modules -type d -prune -o -name dist -type d -prune -exec rm -rf {} +",
        "clean:tsbuildinfo": "find . -name '*.tsbuildinfo' -type f -not -path '*/node_modules/*' -delete",
        "clean:modules": "find . -name node_modules -type d -prune -exec rm -rf {} +"
    },
    "devDependencies": {
        "@repo/internal-config": "workspace:*",
        "@types/node": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "overrides": {
        "vite@*": "catalog:",
        "vitest@*": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.3.4",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=22.18.0"
    }
}

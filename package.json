{
    "name": "pg_lab",
    "version": "0.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*",
        "tools/*"
    ],
    "type": "module",
    "scripts": {
        "ready": "vp check && vp test && vp run -r --concurrency-limit 1 build",
        "dev": "vp -C apps/playground dev --host",
        "dev:brouillon": "vp -C apps/brouillon dev --host",
        "build": "vp run @repo/playground#build",
        "prepare": "vp config"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.3.4",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=22.18.0"
    }
}

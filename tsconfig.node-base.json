{
    // Shared base for vite.config.ts typechecking (node, nodenext).
    // Per-package configs only add their own tsBuildInfoFile + include.
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "noEmit": true
    }
}

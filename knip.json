{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "tags": ["-lintignore"],
    "workspaces": {
        ".": {},
        "packages/randomart": {
            "entry": [
                "src/main.tsx!",
                "src/dataset/page.ts!",
                "scripts/dataset/cli.ts!",
                "scripts/probe-webgl.mjs!",
                "src/**/*.test.ts",
                "scripts/**/*.test.ts"
            ],
            "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.{ts,mjs}!"],
            "ignoreDependencies": [
                "@rolldown/plugin-babel",
                "@stylexjs/unplugin",
                "@vitejs/plugin-react",
                "babel-plugin-react-compiler",
                "lightningcss"
            ],
            "ignoreExportsUsedInFile": true,
            "ignore": [
                "src/core/compiler/contract.ts",
                "src/core/compiler/index.ts",
                "src/core/expression/index.ts",
                "src/core/expression/traverse.ts",
                "src/core/expression/types.ts",
                "src/core/grammar/grammar.ts",
                "src/core/grammar/index.ts",
                "src/core/notebook/notebook.ts"
            ]
        }
    }
}

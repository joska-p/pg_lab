{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["vite/client"],
        "allowArbitraryExtensions": true,
        "noEmit": true,
        "jsx": "react-jsx"
    },
    "include": ["src"]
}

{
    "name": "@repo/ui",
    "version": "0.0.0",
    "description": "This is a small personal UI toolkit for creative mini-apps.",
    "license": "MIT",
    "author": "Joska <joska-p@gmail.com>",
    "type": "module",
    "exports": {
        "./styles": "./src/styles.css",
        "./tokens/*": {
            "source": "./src/tokens/*.ts",
            "types": "./dist/tokens/*.d.mts",
            "import": "./dist/tokens/*.mjs"
        },
        "./recipes/*": {
            "source": "./src/recipes/*.ts",
            "types": "./dist/recipes/*.d.mts",
            "import": "./dist/recipes/*.mjs"
        },
        "./components/*": {
            "source": "./src/components/*.tsx",
            "types": "./dist/components/*.d.mts",
            "import": "./dist/components/*.mjs"
        },
        "./stylex-preset": {
            "source": "./src/stylex-preset.ts",
            "types": "./dist/stylex-preset.d.mts",
            "import": "./dist/stylex-preset.mjs"
        }
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "check": "vp check"
    },
    "devDependencies": {
        "@rolldown/plugin-babel": "catalog:",
        "@stylexjs/stylex": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "typescript": "catalog:",
        "unplugin-stylex": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "@stylexjs/stylex": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:"
    }
}

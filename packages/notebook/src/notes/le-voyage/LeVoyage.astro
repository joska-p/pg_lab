---
type Level = {
    num: number;
    name: string;
    short: string;
    color: string;
    letter: string;
    api: string;
    envelope: string;
    action: string;
};

const LEVELS: Level[] = [
    {
        num: 1,
        name: 'Humain',
        short: 'Humain',
        color: '#ebdbb2',
        letter: 'L’intention d’envoyer une note',
        api: 'Le doigt sur le bouton de la souris',
        envelope: 'Mouvement physique',
        action: 'La lettre est glissée dans une enveloppe de mouvement physique.'
    },
    {
        num: 2,
        name: 'Matériel (Hardware)',
        short: 'Hardware',
        color: '#fe8019',
        letter: 'Le mouvement physique',
        api: 'Le capteur mécanique de la souris',
        envelope: 'Impulsion électrique · 5 V',
        action: 'Le mouvement est reconditionné en impulsion électrique (5 V). L’ancienne enveloppe est jetée.'
    },
    {
        num: 3,
        name: 'Système d’Exploitation (OS)',
        short: 'OS',
        color: '#fb4934',
        letter: 'L’impulsion électrique',
        api: 'Le port USB · pilote (driver)',
        envelope: 'Event système',
        action: 'L’électricité est extraite puis reconditionnée dans un « event » système standardisé.'
    },
    {
        num: 4,
        name: 'Navigateur (DOM)',
        short: 'DOM',
        color: '#d3869b',
        letter: 'L’event système',
        api: 'L’API Web (DOM)',
        envelope: 'Objet JavaScript · onClick',
        action: 'L’event système est reconditionné dans un objet JavaScript (onClick).'
    },
    {
        num: 5,
        name: 'Logique Applicative (JavaScript)',
        short: 'JS',
        color: '#fabd2f',
        letter: 'L’objet JavaScript (l’event)',
        api: 'La fonction fetch()',
        envelope: 'Requête HTTP',
        action: 'L’objet JS est reconditionné dans une requête HTTP (texte formaté).'
    },
    {
        num: 6,
        name: 'Transport (TCP)',
        short: 'TCP',
        color: '#b8bb26',
        letter: 'La requête HTTP',
        api: 'Le port (ex. 443)',
        envelope: 'Segment TCP',
        action: 'La requête HTTP est reconditionnée dans un segment TCP.'
    },
    {
        num: 7,
        name: 'Réseau (IP)',
        short: 'IP',
        color: '#8ec07c',
        letter: 'Le segment TCP',
        api: 'L’adresse IP source / destination',
        envelope: 'Paquet IP',
        action: 'Le segment TCP est reconditionné dans un paquet IP.'
    },
    {
        num: 8,
        name: 'Physique Réseau (Ethernet)',
        short: 'Ethernet',
        color: '#83a598',
        letter: 'Le paquet IP',
        api: 'L’adresse MAC de la carte réseau',
        envelope: 'Trame réseau',
        action: 'Le paquet IP est reconditionné dans une trame réseau (signal électrique / ondes radio).'
    }
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<le-voyage-doc class="mx-auto block w-full max-w-6xl px-5 py-16 sm:py-24">
    <header class="mb-12 sm:mb-16">
        <p class="text-foreground-dim text-xs tracking-[0.25em] uppercase">
            Note interactive · une lettre, huit enveloppes
        </p>
        <h2 class="mt-3 text-[clamp(1.8rem,4vw,2.9rem)] leading-tight font-semibold">
            Le voyage d’un clic
        </h2>
        <p class="text-foreground-muted mt-4 max-w-2xl text-sm leading-relaxed sm:text-base">
            Une seule intention, huit reconditionnements. À chaque étape, la lettre est extraite de
            son enveloppe, lue par l’interface du niveau, puis glissée dans une enveloppe neuve,
            adaptée au médium suivant. L’ancienne enveloppe n’est pas empilée&nbsp;: elle est
            abandonnée sur place.
        </p>
    </header>

    <!-- Timeline -->
    <nav
        class="-mx-5 mb-10 overflow-x-auto px-5 pb-2 sm:mb-12"
        aria-label="Progression du voyage, étape par étape"
    >
        <div class="relative min-w-[43rem]">
            <div
                class="timeline-track"
                aria-hidden="true"
            >
                <i
                    class="track-fill"
                    data-track-fill
                    style="width:0%"
                ></i>
            </div>
            <ol class="flex w-full">
                {
                    LEVELS.map((level, index) => (
                        <li class="min-w-[3.25rem] flex-1 px-0.5 sm:px-1">
                            <button
                                type="button"
                                data-node-index={index}
                                class:list={['node', index === 0 && 'is-current']}
                                style={`--lv: ${level.color}`}
                                aria-label={`Étape ${pad(level.num)} · ${level.name}`}
                            >
                                <span class="node-dot">{pad(level.num)}</span>
                                <span class="node-name">{level.short}</span>
                            </button>
                        </li>
                    ))
                }
            </ol>
        </div>
    </nav>

    <!-- Scènes -->
    <div class="glass-panel rounded-2xl p-5 sm:p-8 lg:p-10">
        <p
            class="sr-only"
            role="status"
            data-status
        >
        </p>

        {
            LEVELS.map((level, index) => {
                const prev = index > 0 ? LEVELS[index - 1] : null;
                return (
                    <article
                        class:list={['levoyage-step', index === 0 && 'is-active']}
                        data-step-index={index}
                        style={`--lv: ${level.color}`}
                    >
                        <header class="step-head">
                            <div>
                                <p class="step-kicker">
                                    Étape {pad(level.num)} <span class="opacity-50">/ 08</span>
                                </p>
                                <h3 class="step-name">
                                    <span
                                        class="step-swatch"
                                        aria-hidden="true"
                                    />
                                    {level.name}
                                </h3>
                            </div>
                            <span
                                class="step-watermark"
                                aria-hidden="true"
                            >
                                {pad(level.num)}
                            </span>
                        </header>

                        <div class="pipeline">
                            {/* 1 · Ancienne enveloppe */}
                            <section class="stop">
                                <p class="stop-label">Enveloppe précédente</p>
                                {prev ? (
                                    <div class="card old-card">
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="size-9 shrink-0"
                                            aria-hidden="true"
                                        >
                                            <rect
                                                x="3"
                                                y="5"
                                                width="18"
                                                height="14"
                                                rx="2"
                                            />
                                            <path d="m3 7 9 6 9-6" />
                                        </svg>
                                        <span class="old-name">{prev.envelope}</span>
                                    </div>
                                ) : (
                                    <div class="card old-ghost">
                                        aucune enveloppe —
                                        <br />
                                        la lettre naît libre
                                    </div>
                                )}
                                <p class="stop-note">
                                    {prev ? (
                                        <span class="discarded">✗ enveloppe abandonnée</span>
                                    ) : (
                                        <span class="bare">état initial</span>
                                    )}
                                </p>
                            </section>

                            <div
                                class="flow-arrow"
                                aria-hidden="true"
                            >
                                {prev && <i class="rupture">✗</i>}
                            </div>

                            {/* 2 · La lettre */}
                            <section class="stop stop-letter">
                                <p class="stop-label">La lettre</p>
                                <div class="paper">
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="size-5 shrink-0"
                                        aria-hidden="true"
                                    >
                                        <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
                                        <path d="M14 3v6h6" />
                                    </svg>
                                    <blockquote>«&nbsp;{level.letter}&nbsp;»</blockquote>
                                </div>
                                <p class="stop-note">
                                    {prev ? (
                                        <span class="neutral">extraite de l’enveloppe</span>
                                    ) : (
                                        <span class="neutral">nue, sans contenant</span>
                                    )}
                                </p>
                            </section>

                            <div
                                class="flow-arrow"
                                aria-hidden="true"
                            />

                            {/* 3 · Interface / API */}
                            <section class="stop">
                                <p class="stop-label">Interface · API</p>
                                <div class="card api-card">
                                    <span
                                        class="api-glyph"
                                        aria-hidden="true"
                                    >
                                        {'{ }'}
                                    </span>
                                    <span class="api-name">{level.api}</span>
                                </div>
                                <p class="stop-note">
                                    <span class="neutral">ouvre, lit, transfère</span>
                                </p>
                            </section>

                            <div
                                class="flow-arrow"
                                aria-hidden="true"
                            />

                            {/* 4 · Nouvelle enveloppe */}
                            <section class="stop">
                                <p class="stop-label">Nouvelle enveloppe</p>
                                <div class="card new-card">
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="size-9 shrink-0"
                                        aria-hidden="true"
                                    >
                                        <rect
                                            x="3"
                                            y="5"
                                            width="18"
                                            height="14"
                                            rx="2"
                                        />
                                        <path d="m3 7 9 6 9-6" />
                                    </svg>
                                    <span class="new-name">{level.envelope}</span>
                                </div>
                                <p class="stop-note">
                                    <span class="sealed">● neuve · scellée</span>
                                </p>
                            </section>
                        </div>

                        <p class="action">
                            <span class="action-label">L’action</span>
                            {level.action}
                        </p>
                    </article>
                );
            })
        }
    </div>

    <!-- Contrôles -->
    <footer class="mt-10 flex items-center justify-between gap-6">
        <button
            type="button"
            data-action="prev"
            class="ctl"
            disabled
        >
            ← Précédent
        </button>
        <p class="text-foreground-dim hidden items-center gap-2 text-xs sm:flex">
            clavier
            <kbd class="border-border rounded border px-1.5 py-0.5">←</kbd>
            <kbd class="border-border rounded border px-1.5 py-0.5">→</kbd>
        </p>
        <button
            type="button"
            data-action="next"
            class="ctl ctl-next"
        >
            <span data-next-label>Suivant →</span>
        </button>
    </footer>

    <p class="text-foreground-dim mt-14 max-w-2xl text-xs leading-relaxed">
        Ce voyage n’est pas un emboîtement à la poupée russe&nbsp;: il n’y a jamais qu’une seule
        enveloppe à la fois. À chaque niveau, l’interface ouvre l’ancienne, en extrait la lettre —
        qui ne change jamais — puis la referme dans une enveloppe taillée pour le médium suivant.
    </p>
</le-voyage-doc>

<style>
    /* ===== Timeline ===== */

    .timeline-track {
        position: absolute;
        top: 17px;
        left: calc(100% / 16);
        right: calc(100% / 16);
        height: 2px;
        border-radius: 999px;
        background: color-mix(in oklch, var(--border) 75%, transparent);
    }

    .track-fill {
        display: block;
        height: 100%;
        width: 0%;
        border-radius: inherit;
        background: var(--fill-c, var(--foreground-dim));
        transition:
            width var(--transition-normal),
            background-color var(--transition-normal);
    }

    .node {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.55rem;
        width: 100%;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .node:focus-visible {
        outline: none;
    }

    .node:focus-visible .node-dot {
        box-shadow:
            0 0 0 2px var(--background),
            0 0 0 4px color-mix(in oklch, var(--lv) 65%, transparent);
    }

    .node-dot {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        font-size: 0.65rem;
        letter-spacing: 0.08em;
        border-radius: 999px;
        color: var(--foreground-dim);
        border: 1px solid color-mix(in oklch, var(--border) 80%, transparent);
        background: var(--background);
        transition:
            background-color var(--transition-normal),
            border-color var(--transition-normal),
            color var(--transition-normal),
            box-shadow var(--transition-normal);
    }

    .node-name {
        font-size: 0.58rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--foreground-dim);
        transition: color var(--transition-normal);
    }

    .node:hover .node-dot {
        border-color: color-mix(in oklch, var(--lv) 55%, transparent);
        color: var(--foreground);
    }

    .node.is-done .node-dot {
        border-color: color-mix(in oklch, var(--lv) 40%, transparent);
        background: color-mix(in oklch, var(--lv) 8%, transparent);
        color: color-mix(in oklch, var(--lv) 65%, var(--foreground));
    }

    .node.is-current .node-dot {
        background: var(--lv);
        border-color: var(--lv);
        color: #1d2021;
        font-weight: 700;
        box-shadow: 0 0 20px -4px color-mix(in oklch, var(--lv) 80%, transparent);
    }

    .node.is-current .node-name {
        color: var(--foreground);
    }

    /* ===== Scènes ===== */

    .levoyage-step {
        display: none;
    }

    .levoyage-step.is-active {
        display: block;
    }

    .step-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 1.25rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    }

    .step-kicker {
        font-size: 0.62rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--foreground-dim);
    }

    .step-name {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-top: 0.4rem;
        font-size: clamp(1.05rem, 2vw, 1.35rem);
        font-weight: 600;
        color: var(--foreground);
    }

    .step-swatch {
        width: 0.6rem;
        height: 0.6rem;
        flex-shrink: 0;
        border-radius: 999px;
        background: var(--lv);
        box-shadow: 0 0 14px -2px var(--lv);
    }

    .step-watermark {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 700;
        line-height: 0.9;
        color: var(--lv);
        opacity: 0.09;
        user-select: none;
    }

    /* --- Pipeline --- */

    .pipeline {
        display: flex;
        align-items: stretch;
        gap: 0.65rem;
    }

    .stop {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .stop-letter {
        flex-grow: 1.18;
    }

    .stop-label {
        margin-bottom: 0.7rem;
        font-size: 0.58rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        text-align: center;
        color: var(--foreground-dim);
    }

    .card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.8rem;
        min-height: 8.5rem;
        padding: 1rem 0.85rem;
        text-align: center;
        border-radius: 0.9rem;
    }

    .stop-note {
        margin-top: 0.65rem;
        min-height: 1rem;
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        text-align: center;
    }

    .discarded {
        color: var(--warning);
        font-weight: 600;
    }

    .sealed {
        color: color-mix(in oklch, var(--lv) 85%, white);
    }

    .neutral,
    .bare {
        color: var(--foreground-dim);
    }

    /* Ancienne enveloppe : déchirée, grisée, barrée */
    .old-card {
        position: relative;
        isolation: isolate;
        border: 1px dashed color-mix(in oklch, var(--border) 90%, transparent);
        color: var(--foreground-dim);
        animation: levoyage-discard 0.85s ease 0.6s both;
    }

    .old-card svg {
        opacity: 0.55;
    }

    .old-name {
        font-size: 0.72rem;
        line-height: 1.35;
        text-decoration: line-through;
        text-decoration-color: color-mix(in oklch, var(--warning) 70%, transparent);
        text-decoration-thickness: 1.5px;
    }

    .old-card::after {
        content: '';
        position: absolute;
        z-index: 1;
        left: 10%;
        right: 10%;
        top: 50%;
        height: 2px;
        background: color-mix(in oklch, var(--warning) 75%, transparent);
        transform-origin: left center;
        animation: levoyage-cross 0.35s ease 0.95s both;
    }

    .old-ghost {
        border: 1px dashed color-mix(in oklch, var(--border) 70%, transparent);
        color: var(--foreground-dim);
        font-size: 0.68rem;
        line-height: 1.5;
        animation: levoyage-rise 0.5s ease both;
    }

    /* La lettre : papier physique */
    .paper {
        flex: 1 1 auto;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        min-height: 8.5rem;
        padding: 1rem 1.1rem;
        text-align: center;
        clip-path: polygon(0 0, calc(100% - 13px) 0, 100% 13px, 100% 100%, 0 100%);
        background: #f3ead6;
        color: #3c3836;
        border-radius: 0.35rem;
        box-shadow:
            0 1px 0 rgb(0 0 0 / 0.15),
            0 14px 34px -18px rgb(0 0 0 / 0.55);
        transform: rotate(-1.4deg);
        animation: levoyage-fly 0.55s cubic-bezier(0.2, 0.9, 0.3, 1) 0.22s both;
    }

    .paper::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        border-style: solid;
        border-width: 0 13px 13px 0;
        border-color: transparent #ddd0b1 transparent transparent;
    }

    .paper svg {
        color: #a89984;
    }

    .paper blockquote {
        font-size: 0.78rem;
        line-height: 1.55;
        font-weight: 500;
    }

    /* Interface / API */
    .api-card {
        border: 1px solid color-mix(in oklch, var(--border) 80%, transparent);
        background: color-mix(in oklch, var(--foreground) 4%, transparent);
        animation: levoyage-rise 0.5s ease 0.38s both;
    }

    .api-glyph {
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        font-size: 0.85rem;
        font-weight: 700;
        border-radius: 999px;
        color: var(--lv);
        border: 1px solid color-mix(in oklch, var(--lv) 45%, transparent);
        background: color-mix(in oklch, var(--lv) 9%, transparent);
        box-shadow: 0 0 16px -6px color-mix(in oklch, var(--lv) 70%, transparent);
    }

    .api-name {
        font-size: 0.72rem;
        line-height: 1.4;
        color: var(--foreground);
    }

    /* Nouvelle enveloppe : scellée, couleur du niveau */
    .new-card {
        border: 1px solid color-mix(in oklch, var(--lv) 45%, transparent);
        background: linear-gradient(
            155deg,
            color-mix(in oklch, var(--lv) 16%, transparent),
            color-mix(in oklch, var(--lv) 4%, transparent) 60%
        );
        color: var(--lv);
        animation: levoyage-seal 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.62s both;
    }

    .new-name {
        font-size: 0.74rem;
        line-height: 1.35;
        font-weight: 600;
        color: color-mix(in oklch, var(--lv) 80%, var(--foreground));
    }

    /* Flèches de flux */
    .flow-arrow {
        position: relative;
        flex: 0 0 auto;
        align-self: center;
        width: 2.4rem;
        height: 2px;
        border-radius: 999px;
        background-image: repeating-linear-gradient(
            90deg,
            color-mix(in oklch, var(--lv) 50%, transparent) 0 5px,
            transparent 5px 11px
        );
        background-size: 22px 100%;
        animation: levoyage-dash 1.15s linear infinite;
    }

    .flow-arrow::after {
        content: '';
        position: absolute;
        right: -3px;
        top: 50%;
        translate: 0 -50%;
        border-style: solid;
        border-width: 4px 0 4px 6px;
        border-color: transparent transparent transparent
            color-mix(in oklch, var(--lv) 65%, transparent);
    }

    .flow-arrow:first-of-type {
        width: 2rem;
    }

    .rupture {
        position: absolute;
        top: 50%;
        left: 50%;
        translate: -50% -140%;
        font-size: 0.72rem;
        font-weight: 700;
        font-style: normal;
        color: var(--warning);
        animation: levoyage-rise 0.3s ease 0.9s both;
    }

    /* Action */
    .action {
        display: flex;
        align-items: baseline;
        gap: 0.9rem;
        margin-top: 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
        font-size: 0.82rem;
        line-height: 1.65;
        color: var(--foreground-muted);
        animation: levoyage-rise 0.5s ease 0.55s both;
    }

    .action-label {
        flex-shrink: 0;
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: color-mix(in oklch, var(--lv) 75%, var(--foreground));
    }

    /* Contrôles */
    .ctl {
        cursor: pointer;
        padding: 0.6rem 1.15rem;
        font-size: 0.8rem;
        border-radius: 0.6rem;
        border: 1px solid color-mix(in oklch, var(--border) 90%, transparent);
        color: var(--foreground-muted);
        transition:
            border-color var(--transition-normal),
            color var(--transition-normal),
            opacity var(--transition-normal);
    }

    .ctl:hover:not(:disabled) {
        border-color: color-mix(in oklch, var(--foreground) 45%, transparent);
        color: var(--foreground);
    }

    .ctl:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px color-mix(in oklch, var(--foreground) 40%, transparent);
    }

    .ctl:disabled {
        opacity: 0.35;
    }

    .ctl-next {
        border-color: color-mix(in oklch, var(--foreground) 30%, transparent);
        color: var(--foreground);
    }

    /* ===== Animations ===== */

    @keyframes levoyage-rise {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
    }

    @keyframes levoyage-fly {
        from {
            opacity: 0;
            transform: translate(-30px, -4px) rotate(-5deg);
        }
        to {
            opacity: 1;
            transform: rotate(-1.4deg);
        }
    }

    @keyframes levoyage-seal {
        from {
            opacity: 0;
            transform: scale(0.88) translateY(8px);
        }
    }

    @keyframes levoyage-discard {
        0% {
            opacity: 1;
            transform: none;
        }
        20% {
            transform: translateX(-3px) rotate(-1.4deg);
        }
        40% {
            transform: translateX(3px) rotate(1.2deg);
        }
        60% {
            transform: translateX(-2px) rotate(-0.6deg);
        }
        80% {
            opacity: 0.75;
        }
        100% {
            opacity: 0.42;
            transform: none;
        }
    }

    @keyframes levoyage-cross {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }

    @keyframes levoyage-dash {
        to {
            background-position: 22px 0;
        }
    }

    /* Pipeline vertical (mobile) */
    @media (max-width: 47.99rem) {
        .pipeline {
            flex-direction: column;
            gap: 0.35rem;
        }

        .flow-arrow {
            width: 2px;
            height: 2rem;
            margin-inline: auto;
            background-image: repeating-linear-gradient(
                180deg,
                color-mix(in oklch, var(--lv) 50%, transparent) 0 5px,
                transparent 5px 11px
            );
        }

        .flow-arrow::after {
            right: auto;
            top: auto;
            bottom: -3px;
            left: 50%;
            translate: -50% 0;
            border-width: 6px 4px 0 4px;
            border-color: color-mix(in oklch, var(--lv) 65%, transparent) transparent transparent
                transparent;
        }

        .rupture {
            translate: 50% -50%;
        }

        .action {
            flex-direction: column;
            gap: 0.4rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .pipeline *,
        .flow-arrow,
        .action {
            animation: none !important;
            transition: none !important;
        }

        .old-card {
            opacity: 0.42;
        }

        .old-card::after {
            transform: scaleX(1);
        }
    }
</style>

<script is:inline>
    if (!customElements.get('le-voyage-doc')) {
        customElements.define(
            'le-voyage-doc',
            class LeVoyageDoc extends HTMLElement {
                connectedCallback() {
                    if (this.dataset.ready) return;
                    this.dataset.ready = 'true';

                    this.steps = [...this.querySelectorAll('[data-step-index]')];
                    this.nodes = [...this.querySelectorAll('[data-node-index]')];
                    this.fill = this.querySelector('[data-track-fill]');
                    this.status = this.querySelector('[data-status]');
                    this.prevBtn = this.querySelector('[data-action="prev"]');
                    this.nextBtn = this.querySelector('[data-action="next"]');
                    this.nextLabel = this.querySelector('[data-next-label]');
                    this.index = 0;
                    this.last = this.steps.length - 1;

                    this.nodes.forEach((node, index) => {
                        node.addEventListener('click', () => this.go(index));
                    });
                    this.prevBtn.addEventListener('click', () => this.go(this.index - 1));
                    this.nextBtn.addEventListener('click', () =>
                        this.go(this.index === this.last ? 0 : this.index + 1)
                    );
                    this.addEventListener('keydown', (event) => {
                        if (event.key === 'ArrowRight') {
                            event.preventDefault();
                            this.go(this.index + 1);
                        } else if (event.key === 'ArrowLeft') {
                            event.preventDefault();
                            this.go(this.index - 1);
                        }
                    });

                    this.apply();
                }

                go(index) {
                    this.index = Math.min(this.last, Math.max(0, index));
                    this.apply();
                }

                apply() {
                    const active = this.steps[this.index];
                    const name = active.querySelector('.step-name').textContent.trim();

                    this.steps.forEach((step, index) => {
                        const isActive = index === this.index;
                        step.classList.toggle('is-active', isActive);
                        step.toggleAttribute('inert', !isActive);
                    });
                    this.nodes.forEach((node, index) => {
                        node.classList.toggle('is-current', index === this.index);
                        node.classList.toggle('is-done', index < this.index);
                        if (index === this.index) {
                            node.setAttribute('aria-current', 'step');
                        } else {
                            node.removeAttribute('aria-current');
                        }
                    });

                    const color = this.nodes[this.index].style.getPropertyValue('--lv').trim();
                    this.fill.style.width = `${(this.index / this.last) * 100}%`;
                    this.fill.style.setProperty('--fill-c', color);

                    this.prevBtn.disabled = this.index === 0;
                    this.nextLabel.textContent =
                        this.index === this.last ? 'Recommencer ↺' : 'Suivant →';

                    this.status.textContent = `Étape ${this.index + 1} sur ${this.steps.length} : ${name}`;
                }
            }
        );
    }
</script>

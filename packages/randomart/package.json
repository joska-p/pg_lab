{
    "name": "@repo/randomart",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./App": "./src/App.tsx",
        "./Scene": "./src/components/Scene.tsx",
        "./Controls": "./src/components/Controls.tsx"
    },
    "scripts": {
        "dev": "vp dev",
        "build": "tsc -b && vp build",
        "lint": "vp lint",
        "test": "vp test",
        "test:glsl": "sh scripts/validate-glsl.sh",
        "test:measure": "VITE_MEASURE=1 vp test measure",
        "test:shaders": "VITE_DUMP_SHADERS=$PWD/.shaders vp test dump",
        "dataset": "node scripts/dataset/cli.ts run",
        "dataset:write": "node scripts/dataset/cli.ts write",
        "dataset:features": "node scripts/dataset/cli.ts features",
        "dataset:pca": "node scripts/dataset/cli.ts pca",
        "dataset:sheet": "node scripts/dataset/cli.ts sheet",
        "preview": "vp preview"
    },
    "dependencies": {
        "@repo/glaze": "workspace:*",
        "@repo/ui": "workspace:*",
        "react": "catalog:",
        "react-dom": "catalog:",
        "zustand": "catalog:"
    },
    "devDependencies": {
        "@rolldown/plugin-babel": "catalog:",
        "@stylexjs/stylex": "catalog:",
        "@stylexjs/unplugin": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "babel-plugin-react-compiler": "catalog:",
        "lightningcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    }
}

{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../../tsconfig.node",
    // The CLI scripts import the shared pure core, which uses extensionless
    // imports (repo convention). Bundler resolution keeps both programs green;
    // tsx executes the CLI at runtime, so noEmit stays on.
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler"
    },
    "include": ["src/core/node"]
}

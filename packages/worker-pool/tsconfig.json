{
    // Typecheck-only config: vp pack (tsdown + tsgo) owns emit and dts.
    "extends": "@repo/internal-config/base.json",
    "compilerOptions": {
        "target": "esnext",
        "lib": ["ES2023", "WebWorker"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "noEmit": true
    }
}

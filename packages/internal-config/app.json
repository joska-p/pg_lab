{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./base.json",
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["vite/client"],
        "allowArbitraryExtensions": true,
        "noEmit": true,
        "jsx": "react-jsx"
    }
}

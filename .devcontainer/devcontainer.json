{
    "name": "pg-container",
    "image": "mcr.microsoft.com/devcontainers/base:debian",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "configureZshAsDefaultShell": true
        },
        "ghcr.io/devcontainers-extra/features/ffmpeg-apt-get:1": {}
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/pg-container,type=bind",
    "workspaceFolder": "/workspaces/pg-container",
    "remoteUser": "vscode",
    "runArgs": ["--userns=keep-id", "--net=host"]
}

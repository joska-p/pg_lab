# Définir dev_home comme HOME de dev
export DEV_HOME="$HOME/Work/dev/dev_home"

# Ajouter tous tes dossiers de binaires de dev_home au PATH
PATH_add "$DEV_HOME/.opencode/bin"
PATH_add "$DEV_HOME/.local/share/vite-plus/bin"
PATH_add "$DEV_HOME/.local/share/pnpm"
PATH_add "$DEV_HOME/.local/bin"

# Si tu as d'autres répertoires dans dev_home, ajoute-les ici :
# PATH_add "$DEV_HOME/.nvm/versions/node/v20.0.0/bin"

# Charger les scripts d'environnement spécifiques si tu en as
if [ -f "$DEV_HOME/.config/vite-plus/env" ]; then
  source "$DEV_HOME/.config/vite-plus/env"
fi

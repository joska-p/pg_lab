# 1. Définir la base dev_home
export DEV_HOME="$HOME/Work/dev/dev_home"

# 2. Redéfinir la structure XDG vers dev_home
export XDG_CONFIG_HOME="$DEV_HOME/.config"
export XDG_DATA_HOME="$DEV_HOME/.local/share"
export XDG_CACHE_HOME="$DEV_HOME/.cache"
export XDG_STATE_HOME="$DEV_HOME/.local/state"

# 3. Forcer le HOME pour les outils qui n'honorent pas XDG (npm, cargo, etc.)
export HOME="$DEV_HOME"

# 4. Ajuster le PATH avec PATH_add (ordre de priorité pour direnv)
PATH_add "$DEV_HOME/.opencode/bin"
PATH_add "$DEV_HOME/.local/share/vite-plus/bin"
PATH_add "$DEV_HOME/.local/share/pnpm"
PATH_add "$DEV_HOME/.local/bin"

# 5. Charger l'environnement Vite+ s'il existe
if [ -f "$DEV_HOME/.config/vite-plus/env" ]; then
  source "$DEV_HOME/.config/vite-plus/env"
fi
